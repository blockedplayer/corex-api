    <EmbeddedResource Include="C:\Program Files\Microsoft Visual Studio\18\Community\VC\Redist\MSVC\14.51.36231\x64\Microsoft.VC145.CRT\msvcp140.dll" LogicalName="msvcp140.dll" />
  </ItemGroup>
</Project>
