    <EmbeddedResource Include="$(UserProfile)\Desktop\PremiumCoreX\mw2\mw2 working example\Build\SecureEngineSDK64.dll" LogicalName="SecureEngineSDK64.dll" />
    <EmbeddedResource Include="$(UserProfile)\Desktop\PremiumCoreX\mw2\mw2 working example\Build\FixGame.exe" LogicalName="FixGame.exe" />
    <EmbeddedResource Include="$(ProjectDir)proxy\x64\Release\version.dll" LogicalName="version.dll" />
